import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import EventCard from '../../components/EventCard.astro';
import EventRegistration from '../../components/EventRegistration.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getAllEvents, excerptFrom, type SiteEvent } from '../../lib/events';
import { chapters } from '../../data/chapters';
import { formatLongDate, isPast } from '../../utils/date';
import { withBase } from '../../utils/paths';
import { selectRows } from '../../lib/supabase';

export const prerender = false;

interface SupabaseEvent {
    id: string;
    slug: string;
    title: string;
    event_date: string;
    chapter: string;
    description: string;
    body: string | null;
    image_url: string | null;
    location: string | null;
    event_time: string | null;
    registration_link: string | null;
    registration_open: boolean | null;
    featured: boolean | null;
    published: boolean | null;
    tags: string[] | null;
}

const slug = Astro.params.slug;

if (!slug) {
    Astro.response.status = 404;
    throw new Error('Event slug is missing.');
}

const rows = await selectRows<SupabaseEvent>('events', {
    select: '*',
    slug: `eq.${slug}`,
    published: 'eq.true',
    limit: '1',
});

const row = rows[0];

if (!row) {
    Astro.response.status = 404;
    throw new Error(`Event "${slug}" not found.`);
}

const event = {
    id: row.slug,
    data: {
        title: row.title,
        date: new Date(`${row.event_date}T00:00:00`),
        chapter: row.chapter,
        description: row.description?.trim() || excerptFrom(row.body),
        body: row.body ?? '',
        image: row.image_url ?? undefined,
        location: row.location ?? undefined,
        time: row.event_time ?? undefined,
        registrationLink: row.registration_link ?? undefined,
        registrationOpen: Boolean(row.registration_open),
        tags: Array.isArray(row.tags) ? row.tags : [],
    },
} as SiteEvent;

const eventId = event.id;
const eventSlug = event.id;

// Markdown events render through Astro;
// Supabase events carry plain-text paragraphs.
const Content = event.entry
    ? (await render(event.entry)).Content
    : null;

type Block =
    | { type: 'p' | 'h2' | 'h3'; text: string }
    | { type: 'ul'; items: string[] };

/** Every line break in the dashboard text counts: one line = one paragraph, "•" / "-" / "*" lines = a list. */
function parseBody(body: string, title: string): Block[] {
    const blocks: Block[] = [];
    const lines = body.replace(/\r/g, '').split('\n').map((line) => line.trim());

    // Dashboard text often starts by repeating the event title; the page already shows it.
    const firstIndex = lines.findIndex(Boolean);
    if (firstIndex >= 0 && lines[firstIndex].toLowerCase() === title.trim().toLowerCase()) {
        lines.splice(firstIndex, 1);
    }

    for (const line of lines) {
        if (!line) continue;
        const bullet = line.match(/^(?:[•\-*])\s+(.*)$/);
        if (bullet) {
            const last = blocks[blocks.length - 1];
            if (last?.type === 'ul') last.items.push(bullet[1]);
            else blocks.push({ type: 'ul', items: [bullet[1]] });
        } else if (line.startsWith('### ')) {
            blocks.push({ type: 'h3', text: line.slice(4) });
        } else if (line.startsWith('## ')) {
            blocks.push({ type: 'h2', text: line.slice(3) });
        } else {
            blocks.push({ type: 'p', text: line });
        }
    }
    return blocks;
}

/** Splits text so plain URLs can be rendered as links. */
function linkParts(text: string): { text: string; href?: string }[] {
    return text
        .split(/(https?:\/\/[^\s<]+)/g)
        .filter(Boolean)
        .map((part) => {
            if (!/^https?:\/\//.test(part)) return { text: part };
            const href = part.replace(/[.,;:!?)]+$/, '');
            return { text: href, href };
        });
}

const blocks = parseBody(event.body ?? '', event.data.title);

const chapter = chapters.find(
    (item) => item.shortName === event.data.chapter,
);

const past = isPast(event.data.date);

const related = (await getAllEvents())
    .filter(
       (item) =>
          item.id !== event.id &&
          item.data.chapter === event.data.chapter,
    )
    .sort(
       (a, b) =>
          b.data.date.getTime() -
          a.data.date.getTime(),
    )
    .slice(0, 3);
---

<Layout
    title={`${event.data.title} | IEEE MIST`}
    description={event.data.description}
>
    <Header />

    <main data-event-page data-event-id={eventId} data-event-slug={eventSlug}>
        <section class="event-hero">
            <div class="hero-circuit hero-circuit-left" aria-hidden="true"></div>
            <div class="hero-circuit hero-circuit-right" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
                <i></i><i></i><i></i><i></i>
            </div>

            <div class="container hero-inner">
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                    <a href={withBase('/')}>Home</a>
                    <span>/</span>
                    <a href={withBase('/events')}>Events</a>
                    <span>/</span>
                    <span data-event-breadcrumb>{event.data.title}</span>
                </nav>

                <div class="hero-copy">
                    <p class="hero-eyebrow" data-event-eyebrow>
                        {chapter ? `${chapter.code} · ${chapter.fullName}` : 'IEEE MIST Student Branch'}
                    </p>
                    <h1 data-event-title>{event.data.title}</h1>
                    {event.data.description && <p class="hero-description" data-event-description>{event.data.description}</p>}
                </div>
            </div>
        </section>

        <section class="detail">
            <div class="container detail-grid">
                <article class="content">
                    {
                        event.data.image && (
                            <div class="cover" data-event-cover>
                                <img
                                    src={withBase(event.data.image)}
                                    alt={event.data.title}
                                    data-event-image
                                />
                            </div>
                        )
                    }

                    <ul class="tags" data-event-tags hidden={event.data.tags.length === 0}>
                        {event.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>

                    <div class="prose" data-event-body>
                        {
                            Content ? (
                                <Content />
                            ) : blocks.length === 0 ? (
                                <p>Event details will be announced soon.</p>
                            ) : (
                                blocks.map((block) =>
                                    block.type === 'ul' ? (
                                        <ul>
                                            {block.items.map((item) => (
                                                <li>
                                                    {linkParts(item).map((part) =>
                                                        part.href ? (
                                                            <a href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a>
                                                        ) : (
                                                            part.text
                                                        ),
                                                    )}
                                                </li>
                                            ))}
                                        </ul>
                                    ) : block.type === 'h2' ? (
                                        <h2>{block.text}</h2>
                                    ) : block.type === 'h3' ? (
                                        <h3>{block.text}</h3>
                                    ) : (
                                        <p>
                                            {linkParts(block.text).map((part) =>
                                                part.href ? (
                                                    <a href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a>
                                                ) : (
                                                    part.text
                                                ),
                                            )}
                                        </p>
                                    )
                                )
                            )
                        }
                    </div>
                </article>

                <aside class="sidebar">
                    <div class="registration-card">
                        <p class="card-title" data-event-card-title>
                            {past ? 'Event Details' : 'Registration'}
                        </p>

                        <dl class="event-meta">
                            <div>
                                <dt>Date</dt>
                                <dd data-event-date>{formatLongDate(event.data.date)}</dd>
                            </div>

                            <div data-event-time-row hidden={!event.data.time}>
                                <dt>Time</dt>
                                <dd data-event-time>{event.data.time}</dd>
                            </div>

                            <div data-event-location-row hidden={!event.data.location}>
                                <dt>Venue</dt>
                                <dd data-event-location>{event.data.location}</dd>
                            </div>

                            <div>
                                <dt>Organised by</dt>
                                <dd data-event-organiser>
                                    {chapter ? chapter.fullName : 'IEEE MIST Student Branch'}
                                </dd>
                            </div>
                        </dl>

                        <div data-event-registration>
                            {
                                past ? (
                                    <p class="closed">This event has already taken place.</p>
                                ) : event.data.registrationOpen ? (
                                    <>
                                        <EventRegistration slug={event.id} />
                                        {event.data.registrationLink && (
                                            <p class="alt">
                                                Prefer an external form?{' '}
                                                <a
                                                    href={event.data.registrationLink}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >
                                                    Register there instead
                                                </a>
                                            </p>
                                        )}
                                    </>
                                ) : (
                                    <p class="closed">Registration for this event is closed.</p>
                                )
                            }
                        </div>
                    </div>

                    {
                        chapter && (
                            <a
                                class="chapter-card"
                                href={withBase(`/chapters/${chapter.slug}`)}
                                style={`--accent:${chapter.accent}`}
                            >
                                <span class="card-logo">
                                    <img src={chapter.logoWhite} alt="" loading="lazy" />
                                </span>
                                <span class="card-text">
                                    <strong>{chapter.code}</strong>
                                    <span>{chapter.fullName}</span>
                                </span>
                            </a>
                        )
                    }

                    <a class="back" href={withBase('/events')}>← Back to all events</a>
                </aside>
            </div>
        </section>

        {
            related.length > 0 && (
                <section class="related">
                    <div class="container">
                        <div class="section-heading">
                            <p>EXPLORE MORE</p>
                            <h2>More from {chapter ? chapter.code : 'the branch'}</h2>
                        </div>

                        <div class="event-grid">
                            {related.map((item) => (
                                <EventCard
                                    title={item.data.title}
                                    date={item.data.date}
                                    chapter={item.data.chapter}
                                    description={item.data.description}
                                    image={item.data.image}
                                    location={item.data.location}
                                    href={withBase(`/events/${item.id}`)}
                                    past={isPast(item.data.date)}
                                />
                            ))}
                        </div>
                    </div>
                </section>
            )
        }

        <Newsletter />
    </main>

    <Footer />
</Layout>

<script>
    import { supabase } from '../../lib/supabase-browser';

    interface SupabaseEvent {
        id: string;
        slug: string;
        title: string;
        event_date: string;
        chapter: string;
        description: string;
        body: string | null;
        image_url: string | null;
        location: string | null;
        event_time: string | null;
        registration_link: string | null;
        registration_open: boolean | null;
        featured: boolean | null;
        published: boolean | null;
        tags: string[] | null;
    }

    const page = document.querySelector<HTMLElement>('[data-event-page]');

    if (page) {
        const eventSlug = page.dataset.eventSlug || page.dataset.eventId;

        if (eventSlug) {
            function formatEventDate(value: string): string {
                const date = new Date(`${value}T00:00:00Z`);
                if (Number.isNaN(date.getTime())) return value;

                return new Intl.DateTimeFormat('en-US', {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                    timeZone: 'UTC',
                }).format(date);
            }

            function isPastEvent(value: string): boolean {
                const date = new Date(`${value}T23:59:59`);
                return date.getTime() < Date.now();
            }

            function setText(selector: string, value: string | null | undefined) {
                const element = page.querySelector<HTMLElement>(selector);
                if (element) element.textContent = value ?? '';
            }

            function appendWithLinks(parent: HTMLElement, text: string) {
                for (const part of text.split(/(https?:\/\/[^\s<]+)/g)) {
                    if (!part) continue;
                    if (/^https?:\/\//.test(part)) {
                        const href = part.replace(/[.,;:!?)]+$/, '');
                        const a = document.createElement('a');
                        a.href = href;
                        a.target = '_blank';
                        a.rel = 'noopener noreferrer';
                        a.textContent = href;
                        parent.appendChild(a);
                        parent.appendChild(document.createTextNode(part.slice(href.length)));
                    } else {
                        parent.appendChild(document.createTextNode(part));
                    }
                }
            }

            function renderBody(body: string | null, title?: string | null) {
                const container = page.querySelector<HTMLElement>('[data-event-body]');
                if (!container) return;

                const lines = (body ?? '').replace(/\r/g, '').split('\n').map((line) => line.trim());

                // Skip a first line that only repeats the event title.
                const firstIndex = lines.findIndex(Boolean);
                if (firstIndex >= 0 && title && lines[firstIndex].toLowerCase() === title.trim().toLowerCase()) {
                    lines.splice(firstIndex, 1);
                }

                container.replaceChildren();

                if (!lines.some(Boolean)) {
                    const p = document.createElement('p');
                    p.textContent = 'Event details will be announced soon.';
                    container.appendChild(p);
                    return;
                }

                let list: HTMLUListElement | null = null;

                for (const line of lines) {
                    if (!line) {
                        list = null;
                        continue;
                    }

                    const bullet = line.match(/^(?:[•\-*])\s+(.*)$/);

                    if (bullet) {
                        if (!list) {
                            list = document.createElement('ul');
                            container.appendChild(list);
                        }
                        const li = document.createElement('li');
                        appendWithLinks(li, bullet[1]);
                        list.appendChild(li);
                        continue;
                    }

                    list = null;

                    if (line.startsWith('### ')) {
                        const h3 = document.createElement('h3');
                        h3.textContent = line.slice(4);
                        container.appendChild(h3);
                    } else if (line.startsWith('## ')) {
                        const h2 = document.createElement('h2');
                        h2.textContent = line.slice(3);
                        container.appendChild(h2);
                    } else {
                        const p = document.createElement('p');
                        appendWithLinks(p, line);
                        container.appendChild(p);
                    }
                }
            }

            function updateRegistration(row: SupabaseEvent) {
                const registration = page.querySelector<HTMLElement>('[data-event-registration]');
                const cardTitle = page.querySelector<HTMLElement>('[data-event-card-title]');
                if (!registration) return;

                const past = isPastEvent(row.event_date);

                if (past) {
                    if (cardTitle) cardTitle.textContent = 'Event Details';
                    registration.innerHTML =
                        '<p class="closed">This event has already taken place.</p>';
                    return;
                }

                if (cardTitle) cardTitle.textContent = 'Registration';

                if (row.registration_open) {
                    if (row.registration_link) {
                        registration.innerHTML = `
                            <a class="live-register-button"
                               href="${row.registration_link}"
                               target="_blank"
                               rel="noopener noreferrer">
                                Register now
                            </a>
                            <p class="alt">Registration is currently open.</p>
                        `;
                    } else {
                        registration.innerHTML =
                            '<p class="registration-live">Registration is open. Please use the registration form.</p>';
                    }
                } else {
                    registration.innerHTML =
                        '<p class="closed">Registration for this event is closed.</p>';
                }
            }

            function updateEventPage(row: SupabaseEvent) {
                setText('[data-event-title]', row.title);
                setText('[data-event-breadcrumb]', row.title);
                if (row.description?.trim()) setText('[data-event-description]', row.description);
                setText('[data-event-date]', formatEventDate(row.event_date));
                setText('[data-event-time]', row.event_time);
                setText('[data-event-location]', row.location);

                document.title = `${row.title} | IEEE MIST`;

                const timeRow = page.querySelector<HTMLElement>('[data-event-time-row]');
                const locationRow = page.querySelector<HTMLElement>('[data-event-location-row]');
                if (timeRow) timeRow.hidden = !row.event_time;
                if (locationRow) locationRow.hidden = !row.location;

                const cover = page.querySelector<HTMLElement>('[data-event-cover]');
                const image = page.querySelector<HTMLImageElement>('[data-event-image]');

                if (row.image_url) {
                    if (image) {
                        image.src = row.image_url;
                        image.alt = row.title;
                    }
                    if (cover) cover.hidden = false;
                } else if (cover) {
                    cover.hidden = true;
                }

                const tags = page.querySelector<HTMLElement>('[data-event-tags]');
                if (tags) {
                    tags.replaceChildren();
                    const list = Array.isArray(row.tags) ? row.tags : [];
                    tags.hidden = list.length === 0;

                    for (const tag of list) {
                        const li = document.createElement('li');
                        li.textContent = tag;
                        tags.appendChild(li);
                    }
                }

                renderBody(row.body, row.title);
                updateRegistration(row);
            }

            async function loadLatestEvent() {
                const { data, error } = await supabase
                    .from('events')
                    .select('*')
                    .eq('slug', eventSlug)
                    .single();

                if (error) {
                    console.error('Failed to load latest event from Supabase:', error);
                    console.error('Event slug used:', eventSlug);
                    return;
                }

                if (data) updateEventPage(data as SupabaseEvent);
            }

            loadLatestEvent();

            const channel = supabase
                .channel(`event-live-${eventSlug}`)
                .on(
                    'postgres_changes',
                    {
                        event: '*',
                        schema: 'public',
                        table: 'events',
                    },
                    (payload) => {
                        const row = (payload.new || payload.old) as Partial<SupabaseEvent>;

                        // The public URL uses the event slug, not the database UUID/id.
                        if (row?.slug !== eventSlug) return;

                        if (
                            payload.eventType === 'INSERT' ||
                            payload.eventType === 'UPDATE'
                        ) {
                            updateEventPage(payload.new as SupabaseEvent);
                        }

                        if (payload.eventType === 'DELETE') {
                            console.warn(`Event ${eventSlug} was deleted.`);
                        }
                    },
                )
                .subscribe((status) => {
                    console.log(`Event Realtime status for ${eventSlug}: ${status}`);
                });

            window.addEventListener('beforeunload', () => {
                supabase.removeChannel(channel);
            });
        }
    }
</script>

<style>
