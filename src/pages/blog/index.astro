---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { withBase } from '../../utils/paths';

// Placeholder posts — replace with real content (content collection or Supabase) later.
const posts = Array.from({ length: 6 }, (_, i) => ({
	title: `Blog post title ${i + 1}`,
	excerpt:
		'A short placeholder summary for this post. Real articles from the IEEE MIST Student Branch will appear here.',
	category: 'Coming soon',
	date: 'Date to be announced',
}));
---

<Layout
	title="Blog | IEEE MIST Student Branch"
	description="Stories, insights and technical articles from the IEEE MIST Student Branch community."
>
	<Header />
	<main>
		<PageHero
			eyebrow="Blog"
			title="Stories & Insights"
			subtitle="Technical articles, event recaps and ideas from the IEEE MIST Student Branch community."
			crumbs={[{ label: 'Home', href: withBase('/') }, { label: 'Blog' }]}
		/>
		<section class="posts">
			<div class="container">
				<div class="grid">
					{
						posts.map((post) => (
							<article class="post">
								<div class="post-media" aria-hidden="true"></div>
								<div class="post-body">
									<span class="post-meta">
										{post.category} • {post.date}
									</span>
									<h3>{post.title}</h3>
									<p>{post.excerpt}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.posts {
		padding: 56px 0 96px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.post {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
		background: #fff;
		transition: box-shadow 0.2s ease;
	}

	.post:hover {
		box-shadow: 0 18px 40px -26px rgba(0, 40, 85, 0.5);
	}

	.post-media {
		aspect-ratio: 16 / 9;
		background: linear-gradient(135deg, var(--color-navy), var(--color-blue));
	}

	.post-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 22px;
	}

	.post-meta {
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.post h3 {
		font-size: 18px;
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-navy);
	}

	.post p {
		font-size: 14px;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	@media (max-width: 1024px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
