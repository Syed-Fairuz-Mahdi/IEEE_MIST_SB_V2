<body>

   <div id="app">
      <div class="boot">
         <div class="boot-spinner"></div>
         <p>Loading dashboard...</p>
      </div>
   </div>


   <script>
      import { createClient } from '@supabase/supabase-js';

      const SUPABASE_URL = 'https://czxhvlqhfqhovuslglpe.supabase.co';
      const SUPABASE_KEY = 'sb_publishable__C3FKDsT53MA-0siZYUbKw_Q26ZkV_H';
      const BUCKET = 'site-content';

      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
      const app = document.getElementById('app')!;

      const CHAPTERS = ['SB', 'EDS', 'APS', 'WIE', 'MTT-S', 'SPS', 'NPSS', 'EMBS'];


      // ============================================================
      // HELPERS
      // ============================================================

      function el<K extends keyof HTMLElementTagNameMap>(
         tag: K,
         attrs: Record<string, string> = {},
         children: (Node | string)[] = [],
      ): HTMLElementTagNameMap[K] {

         const node = document.createElement(tag);

         for (const [k, v] of Object.entries(attrs)) {
            if (k === 'class') {
               node.className = v;
            } else {
               node.setAttribute(k, v);
            }
         }

         for (const child of children) {
            node.append(child);
         }

         return node;
      }


      function toast(
         message: string,
         kind: 'ok' | 'err' = 'ok'
      ) {

         const bar = document.getElementById('toast');

         if (!bar) return;

         bar.textContent = message;

         bar.className = `toast show ${kind}`;

         window.clearTimeout((bar as any)._t);

         (bar as any)._t = window.setTimeout(() => {
            bar.classList.remove('show');
         }, 3500);
      }


      function publicImageUrl(path: string): string {

         return supabase.storage
            .from(BUCKET)
            .getPublicUrl(path)
            .data.publicUrl;
      }


      async function uploadImage(
         file: File,
         folder: string
      ): Promise<string> {

         const ext =
            file.name.split('.').pop() || 'jpg';

         const path =
            `${folder}/${crypto.randomUUID()}.${ext}`;

         const { error } =
            await supabase.storage
               .from(BUCKET)
               .upload(
                  path,
                  file,
                  {
                     cacheControl: '3600',
                     upsert: false
                  }
               );

         if (error) {
            throw error;
         }

         return publicImageUrl(path);
      }


      function imagePicker(
         currentUrl: string | null,
         folder: string,
         onChange: (url: string) => void
      ) {

         const wrap = el('div', {
            class: 'imgpick'
         });

         const preview = el('img', {
            class: 'imgpick-preview',
            src: currentUrl || withBaseNoop('images/placeholder.png'),
            alt: 'Image preview'
         });

         preview.onerror = () => {
            preview.style.visibility = 'hidden';
         };


         const input = el(
            'input',
            {
               type: 'file',
               accept: 'image/*',
               class: 'imgpick-input'
            }
         ) as HTMLInputElement;


         const uploadInfo = el(
            'div',
            {
               class: 'imgpick-info'
            }
         );


         const uploadTitle = el(
            'strong',
            {
               class: 'imgpick-title'
            },
            ['Upload image']
         );


         const uploadText = el(
            'span',
            {
               class: 'imgpick-help'
            },
            ['JPG, PNG or WebP']
         );


         const status = el(
            'span',
            {
               class: 'imgpick-status'
            },
            ['']
         );


         uploadInfo.append(
            uploadTitle,
            uploadText,
            input,
            status
         );


         input.addEventListener(
            'change',
            async () => {

               const file = input.files?.[0];

               if (!file) return;

               if (file.size > 5 * 1024 * 1024) {

                  status.textContent =
                     'Image must be smaller than 5 MB.';

                  status.className =
                     'imgpick-status error-text';

                  return;
               }


               status.textContent =
                  'Uploading...';

               status.className =
                  'imgpick-status';


               try {

                  const url =
                     await uploadImage(
                        file,
                        folder
                     );

                  preview.src = url;

                  preview.style.visibility =
                     'visible';

                  status.textContent =
                     'Image uploaded successfully.';

                  status.className =
                     'imgpick-status success-text';

                  onChange(url);

               } catch (err: any) {

                  status.textContent =
                     `Upload failed: ${err.message || err}`;

                  status.className =
                     'imgpick-status error-text';
               }
            }
         );


         wrap.append(
            preview,
            uploadInfo
         );

         return wrap;
      }


      function withBaseNoop(p: string) {
         return p;
      }


      // ============================================================
      // LOGIN
      // ============================================================

      function renderLogin() {

         app.replaceChildren();


         const page = el(
            'div',
            {
               class: 'login-page'
            }
         );


         const card = el(
            'form',
            {
               class: 'login-card'
            }
         );


         const logo = el(
            'div',
            {
               class: 'login-logo'
            }
         );


         logo.innerHTML = `
            <div class="login-logo-ieee">IEEE</div>
            <div class="login-logo-text">
               MIST Student Branch
            </div>
         `;


         const heading = el(
            'h1',
            {},
            ['Content Dashboard']
         );


         const description = el(
            'p',
            {
               class: 'login-description'
            },
            [
               'Sign in with your administrator account to manage website content.'
            ]
         );


         const email = el(
            'input',
            {
               type: 'email',
               placeholder: 'Email address',
               required: 'true',
               class: 'field'
            }
         ) as HTMLInputElement;


         const password = el(
            'input',
            {
               type: 'password',
               placeholder: 'Password',
               required: 'true',
               class: 'field'
            }
         ) as HTMLInputElement;


         const error = el(
            'p',
            {
               class: 'error'
            },
            ['']
         );


         const submit = el(
            'button',
            {
               type: 'submit',
               class: 'btn primary login-button'
            },
            ['Sign in']
         );


         card.append(
            logo,
            heading,
            description,
            labeled('Email', email),
            labeled('Password', password),
            error,
            submit
         );


         card.addEventListener(
            'submit',
            async (e) => {

               e.preventDefault();

               submit.setAttribute(
                  'disabled',
                  'true'
               );

               submit.textContent =
                  'Signing in...';

               error.textContent = '';


               const {
                  error: signInError
               } =
                  await supabase.auth.signInWithPassword({
                     email: email.value.trim(),
                     password: password.value
                  });


               if (signInError) {

                  error.textContent =
                     signInError.message;

                  submit.removeAttribute(
                     'disabled'
                  );

                  submit.textContent =
                     'Sign in';
               }
            }
         );


         const footer = el(
            'p',
            {
               class: 'login-footer'
            },
            [
               'IEEE MIST Student Branch • Admin Portal'
            ]
         );


         page.append(
            card,
            footer
         );


         app.append(page);
      }


      // ============================================================
      // DASHBOARD TABS
      // ============================================================

      const TABS = [
         {
            id: 'chief_patron',
            group: 'home',
            label: "Chief Patron's Message",
            icon: '👤'
         },
         {
            id: 'counselor',
            group: 'home',
            label: "Counselor's Message",
            icon: '💬'
         },
         {
            id: 'exec',
            group: 'home',
            label: 'Executive Committee',
            icon: '👥'
         },
         {
            id: 'assoc',
            group: 'home',
            label: 'Associate Directors',
            icon: '🧩'
         },
         {
            id: 'activities',
            group: 'home',
            label: 'Recent Activities',
            icon: '📅'
         },
         {
            id: 'settings',
            group: 'home',
            label: 'Publishing',
            icon: '🚀'
         },
         {
            id: 'about',
            group: 'about',
            label: 'About',
            icon: '📄'
         }
,
         {
            id: 'contact',
            group: 'contact',
            label: 'Contact',
            icon: '📨'
         }
      ];


      async function renderShell(
         userEmail: string
      ) {

         app.replaceChildren();


         // ========================================================
         // HEADER
         // ========================================================

         const header =
            el('header', {
               class: 'topbar'
            });


         const brand =
            el('div', {
               class: 'brand'
            });


         brand.innerHTML = `
            <div class="brand-mark">
               IEEE
            </div>

            <div class="brand-content">
               <strong>IEEE MIST</strong>
               <span>Student Branch</span>
            </div>
         `;


         const userArea =
            el('div', {
               class: 'user-area'
            });


         const userInfo =
            el('div', {
               class: 'user-info'
            });


         userInfo.innerHTML = `
            <span class="user-label">
               Signed in as
            </span>

            <span class="user-email">
               ${userEmail}
            </span>
         `;


         const signOut =
            el(
               'button',
               {
                  class: 'btn ghost'
               },
               ['Sign out']
            );


         signOut.addEventListener(
            'click',
            () => supabase.auth.signOut()
         );


         userArea.append(
            userInfo,
            signOut
         );


         header.append(
            brand,
            userArea
         );


         // ========================================================
         // DASHBOARD TITLE
         // ========================================================

         const dashboardIntro =
            el(
               'div',
               {
                  class: 'dashboard-intro'
               }
            );


         dashboardIntro.innerHTML = `
            <div>
               <span class="eyebrow">
                  ADMINISTRATION
               </span>

               <h1>
                  Content Dashboard
               </h1>

               <p>
                  Manage the content displayed across the
                  IEEE MIST Student Branch website.
               </p>
            </div>
         `;


         // ========================================================
         // NAVIGATION
         // ========================================================

         const sidebar =
            el(
               'aside',
               {
                  class: 'dashboard-sidebar',
                  'aria-label': 'Dashboard navigation'
               }
            );

         const sidebarTop = el('div', { class: 'sidebar-top' });
         sidebarTop.innerHTML = `
            <span class="sidebar-kicker">SITE MANAGEMENT</span>
            <strong>Dashboard</strong>
         `;
         sidebar.append(sidebarTop);


         const contentArea =
            el('div', { class: 'dashboard-content' });


         const panelHost =
            el(
               'main',
               {
                  class: 'panel-host'
               }
            );


         const panels:
            Record<string, HTMLElement> = {};


         let currentTabGroup = '';

         for (const tab of TABS) {

            if (tab.group && tab.group !== currentTabGroup) {
               currentTabGroup = tab.group;
               const group = tab.group === 'about' ? 'ABOUT' : tab.group === 'contact' ? 'CONTACT' : 'HOME';
               sidebar.append(
                  el('div', { class: 'sidebar-group-label' }, [group])
               );
            }

            const btn =
               el(
                  'button',
                  {
                     class: 'tab',
                     'data-tab': tab.id,
                     type: 'button'
                  }
               );


            btn.innerHTML = `
               <span class="tab-icon">
                  ${tab.icon}
               </span>

               <span>
                  ${tab.label}
               </span>
            `;


            btn.addEventListener(
               'click',
               () => activate(tab.id)
            );


            sidebar.append(btn);


            panels[tab.id] =
               el(
                  'section',
                  {
                     class: 'panel'
                  }
               );


            panelHost.append(
               panels[tab.id]
            );
         }


         function activate(id: string) {

            for (
               const b of
               sidebar.querySelectorAll('.tab')
            ) {

               b.classList.toggle(
                  'active',
                  (b as HTMLElement)
                     .dataset.tab === id
               );
            }


            for (
               const [pid, p] of
               Object.entries(panels)
            ) {

               p.classList.toggle(
                  'active',
                  pid === id
               );
            }
         }


         // ========================================================
         // APPEND
         // ========================================================

         contentArea.append(
            dashboardIntro,
            panelHost
         );

         const dashboardLayout = el('div', { class: 'dashboard-layout' });
         dashboardLayout.append(sidebar, contentArea);

         app.append(
            header,
            dashboardLayout,
            el(
               'div',
               {
                  id: 'toast',
                  class: 'toast'
               },
               ['']
            )
         );


         // ========================================================
         // LOAD PANELS
         // ========================================================

         await Promise.all([
            renderLeadershipPanel(
               panels.chief_patron,
               'chief_patron'
            ),

            renderLeadershipPanel(
               panels.counselor,
               'counselor'
            ),

            renderMembersPanel(
               panels.exec,
               'executive_committee',
               'exec'
            ),

            renderAssociatesPanel(
               panels.assoc
            ),

            renderActivitiesPanel(
               panels.activities
            ),

            renderSettingsPanel(
               panels.settings
            ),

            renderAboutPanel(
               panels.about
            )
,

            renderContactPanel(
               panels.contact
            )
         ]);


         activate('chief_patron');
      }


      // ============================================================
      // LEADERSHIP MESSAGE
      // ============================================================

      async function renderLeadershipPanel(
         host: HTMLElement,
         id: 'chief_patron' | 'counselor'
      ) {

         host.replaceChildren(
            loadingState()
         );


         const {
            data,
            error
         } =
            await supabase
               .from('leadership_messages')
               .select('*')
               .eq('id', id)
               .maybeSingle();


         if (error) {

            host.replaceChildren(
               errorState(error.message)
            );

            return;
         }


         const row = data || {
            id,
            eyebrow: '',
            heading: '',
            person_name: '',
            person_roles: [],
            message: [],
            image_url: null
         };


         host.replaceChildren();


         host.append(
            sectionHeader(
               id === 'chief_patron'
                  ? "Chief Patron's Message"
                  : "Counselor's Message",
               id === 'chief_patron'
                  ? 'Manage the Chief Patron information displayed on the homepage.'
                  : 'Manage the Counselor information displayed on the homepage.'
            )
         );


         const form =
            el(
               'form',
               {
                  class: 'edit-form'
               }
            );


         const eyebrow =
            field(
               'Eyebrow',
               row.eyebrow || ''
            );


         const heading =
            field(
               'Heading',
               row.heading || ''
            );


         const personName =
            field(
               'Name',
               row.person_name || ''
            );


         const personRoles =
            field(
               'Roles / titles',
               (row.person_roles || []).join('\n'),
               true
            );


         const message =
            field(
               'Message',
               (row.message || []).join('\n\n'),
               true,
               10
            );


         let imageUrl:
            string | null =
            row.image_url || null;


         const picker =
            imagePicker(
               imageUrl,
               `leadership/${id}`,
               (url) => imageUrl = url
            );


         const status =
            el(
               'span',
               {
                  class: 'muted small'
               },
               ['']
            );


         const save =
            el(
               'button',
               {
                  type: 'submit',
                  class: 'btn primary'
               },
               ['Save changes']
            );


         form.append(

            labeled(
               'Photo',
               picker
            ),

            labeled(
               'Eyebrow',
               eyebrow
            ),

            labeled(
               'Heading',
               heading
            ),

            labeled(
               'Name',
               personName
            ),

            labeled(
               'Roles / titles',
               personRoles
            ),

            labeled(
               'Message',
               message
            ),

            el(
               'div',
               {
                  class: 'form-footer'
               },
               [
                  status,
                  save
               ]
            )
         );


         form.addEventListener(
            'submit',
            async (e) => {

               e.preventDefault();

               save.setAttribute(
                  'disabled',
                  'true'
               );

               save.textContent =
                  'Saving...';

               status.textContent =
                  'Saving changes...';


               const paragraphs =
                  message.value
                     .split(/\n\s*\n/)
                     .map(
                        (p) =>
                           p
                              .replace(/\n/g, ' ')
                              .trim()
                     )
                     .filter(Boolean);


               const roles =
                  personRoles.value
                     .split('\n')
                     .map(
                        (r) => r.trim()
                     )
                     .filter(Boolean);


               const {
                  error: upsertError
               } =
                  await supabase
                     .from('leadership_messages')
                     .upsert({
                        id,
                        eyebrow:
                           eyebrow.value.trim(),

                        heading:
                           heading.value.trim(),

                        person_name:
                           personName.value.trim(),

                        person_roles:
                           roles,

                        message:
                           paragraphs,

                        image_url:
                           imageUrl,

                        updated_at:
                           new Date().toISOString()
                     });


               save.removeAttribute(
                  'disabled'
               );

               save.textContent =
                  'Save changes';


               if (upsertError) {

                  status.textContent =
                     `Error: ${upsertError.message}`;

                  toast(
                     'Could not save changes.',
                     'err'
                  );

               } else {

                  status.textContent =
                     'Changes saved successfully.';

                  toast(
                     'Saved. Publish the changes when ready.'
                  );
               }
            }
         );


         host.append(form);
      }


      // ============================================================
      // FORM HELPERS
      // ============================================================

      function field(
         _label: string,
         value: string,
         textarea = false,
         rows = 3
      ) {

         const input =
            textarea
               ? (
                  el(
                     'textarea',
                     {
                        class: 'field',
                        rows: String(rows)
                     }
                  ) as HTMLTextAreaElement
               )
               : (
                  el(
                     'input',
                     {
                        type: 'text',
                        class: 'field'
                     }
                  ) as HTMLInputElement
               );


         input.value = value;

         return input as any;
      }


      function labeled(
         text: string,
         node: Node
      ) {

         const wrap =
            el(
               'label',
               {
                  class: 'labeled'
               }
            );


         wrap.append(
            el(
               'span',
               {
                  class: 'label-text'
               },
               [text]
            ),
            node
         );


         return wrap;
      }


      function sectionHeader(
         title: string,
         description: string
      ) {

         const wrap =
            el(
               'div',
               {
                  class: 'section-header'
               }
            );


         wrap.innerHTML = `
            <div>
               <h2>${title}</h2>
               <p>${description}</p>
            </div>
         `;


         return wrap;
      }


      function loadingState() {

         const wrap =
            el(
               'div',
               {
                  class: 'state-card'
               }
            );


         wrap.innerHTML = `
            <div class="loading-spinner"></div>
            <p>Loading content...</p>
         `;


         return wrap;
      }


      function errorState(
         message: string
      ) {

         const wrap =
            el(
               'div',
               {
                  class: 'state-card error-state'
               }
            );


         wrap.innerHTML = `
            <strong>Something went wrong</strong>
            <p>${message}</p>
         `;


         return wrap;
      }


      // ============================================================
      // EXECUTIVE COMMITTEE
      // ============================================================

      async function renderMembersPanel(
         host: HTMLElement,
         table: string,
         folder: string
      ) {

         host.replaceChildren(
            loadingState()
         );


         const {
            data,
            error
         } =
            await supabase
               .from(table)
               .select('*')
               .order(
                  'sort_order',
                  {
                     ascending: true
                  }
               );


         if (error) {

            host.replaceChildren(
               errorState(error.message)
            );

            return;
         }


         host.replaceChildren();


         host.append(
            sectionHeader(
               'Executive Committee',
               'Manage the members displayed in the Executive Committee section.'
            )
         );


         const info =
            el(
               'div',
               {
                  class: 'info-banner'
               }
            );


         info.innerHTML = `
            <span class="info-icon">💡</span>
            <span>
               Use the Order field to control the position
               of each member on the website.
            </span>
         `;


         const list =
            el(
               'div',
               {
                  class: 'card-list'
               }
            );


         host.append(
            info,
            list,
            addMemberForm()
         );


         for (
            const row of data || []
         ) {

            list.append(
               memberCard(row)
            );
         }


         function memberCard(
            row: any
         ) {

            const card =
               el(
                  'div',
                  {
                     class: 'member-card'
                  }
               );


            const cardHeader =
               el(
                  'div',
                  {
                     class: 'member-card-header'
                  }
               );


            cardHeader.innerHTML = `
               <span class="card-label">
                  COMMITTEE MEMBER
               </span>

               <span class="member-id">
                  #${row.sort_order ?? 0}
               </span>
            `;


            const name =
               field(
                  '',
                  row.name
               );


            const role =
               field(
                  '',
                  row.role
               );


            const department =
               field(
                  '',
                  row.department || ''
               );


            const major =
               field(
                  '',
                  row.major || ''
               );


            const order =
               el(
                  'input',
                  {
                     type: 'number',
                     class: 'field small',
                     value: String(
                        row.sort_order ?? 0
                     )
                  }
               ) as HTMLInputElement;


            let avatarUrl:
               string | null =
               row.avatar_url || null;


            const picker =
               imagePicker(
                  avatarUrl,
                  folder,
                  (url) =>
                     avatarUrl = url
               );


            const status =
               el(
                  'span',
                  {
                     class: 'muted small'
                  },
                  ['']
               );


            const save =
               el(
                  'button',
                  {
                     class: 'btn primary small',
                     type: 'button'
                  },
                  ['Save']
               );


            const del =
               el(
                  'button',
                  {
                     class: 'btn danger small',
                     type: 'button'
                  },
                  ['Delete']
               );


            save.addEventListener(
               'click',
               async () => {

                  status.textContent =
                     'Saving...';

                  save.setAttribute(
                     'disabled',
                     'true'
                  );


                  const {
                     error: err
                  } =
                     await supabase
                        .from(table)
                        .update({
                           name:
                              name.value.trim(),

                           role:
                              role.value.trim(),

                           department:
                              department.value.trim()
                                 || null,

                           major:
                              major.value.trim()
                                 || null,

                           sort_order:
                              Number(order.value)
                              || 0,

