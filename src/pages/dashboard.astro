      async function renderContactPanel(
         host: HTMLElement
      ) {

         host.replaceChildren(
            loadingState()
         );

         const { data, error } =
            await supabase
               .from('contact_page')
               .select('*')
               .eq('id', 'main')
               .maybeSingle();

         if (error) {
            host.replaceChildren(
               errorState(error.message)
            );
            return;
         }

         const row = data || {
            id: 'main',
            hero_title: 'Connect with IEEE MIST',
            hero_description:
               'Questions about membership, an event, or a collaboration? Send us a message and the right person on the committee will get back to you.',
            address_lines: [
               'IEEE MIST Student Branch',
               'Military Institute of Science and Technology',
               'Mirpur Cantonment, Dhaka-1216, Bangladesh'
            ],
            email: 'ieeemistsb@mist.ac.bd',
            office_hours: 'Sunday — Thursday, 10:00 AM to 4:00 PM',
            map_image_url: '',
            socials: [
               { label: 'Facebook', href: 'https://www.facebook.com' },
               { label: 'LinkedIn', href: 'https://www.linkedin.com' },
               { label: 'Instagram', href: 'https://www.instagram.com' },
               { label: 'YouTube', href: 'https://www.youtube.com' }
            ],
            subjects: [
               'General Inquiry',
               'Membership',
               'Event or workshop',
               'Collaboration / sponsorship',
               'Chapter enquiry'
            ],
            faqs: []
         };

         host.replaceChildren();

         host.append(
            sectionHeader(
               'Contact Page',
               'Edit the contact page content and manage messages submitted through the contact form.'
            )
         );

         const form = el('div', { class: 'editor-card' });

         const heroTitle = field('', row.hero_title || '');
         const heroDescription = field('', row.hero_description || '', true, 4);
         const address = field(
            '',
            Array.isArray(row.address_lines)
               ? row.address_lines.join('\n')
               : '',
            true,
            4
         );
         const email = field('', row.email || '');
         const officeHours = field('', row.office_hours || '');
         const mapUrl = field('', row.map_image_url || '');
         const subjects = field(
            '',
            Array.isArray(row.subjects)
               ? row.subjects.join('\n')
               : '',
            true,
            5
         );
         const socials = field(
            '',
            Array.isArray(row.socials)
               ? row.socials.map((x: any) => `${x.label} | ${x.href}`).join('\n')
               : '',
            true,
            6
         );
         const faqs = field(
            '',
            Array.isArray(row.faqs)
               ? row.faqs.map((x: any) => `${x.question} | ${x.answer}`).join('\n')
               : '',
            true,
            8
         );

         heroTitle.placeholder = 'Connect with IEEE MIST';
         heroDescription.placeholder = 'Hero description';
         address.placeholder = 'One address line per line';
         email.placeholder = 'ieeemistsb@mist.ac.bd';
         officeHours.placeholder = 'Sunday — Thursday, 10:00 AM to 4:00 PM';
         mapUrl.placeholder = 'https://...';
         subjects.placeholder = 'One subject per line';
         socials.placeholder = 'Facebook | https://facebook.com/...\nLinkedIn | https://linkedin.com/...';
         faqs.placeholder = 'Question | Answer';

         const save = el(
            'button',
            {
               type: 'button',
               class: 'btn primary'
            },
            ['Save Contact Page']
         );

         const saveStatus = el(
            'span',
            {
               class: 'muted small'
            },
            ['']
         );

         form.append(
            el('h3', {}, ['Page content']),
            labeled('Hero title', heroTitle),
            labeled('Hero description', heroDescription),
            labeled('Address (one line per line)', address),
            labeled('Contact email', email),
            labeled('Office hours', officeHours),
            labeled('Map image URL', mapUrl),
            labeled('Form subjects (one per line)', subjects),
            labeled('Social links (Label | URL)', socials),
            labeled('FAQs (Question | Answer, one per line)', faqs),
            el(
               'div',
               { class: 'publish-action' },
               [save, saveStatus]
            )
         );

         save.addEventListener('click', async () => {
            save.setAttribute('disabled', 'true');
            saveStatus.textContent = 'Saving...';

            const parseLines = (value: string) =>
               value
                  .split('\n')
                  .map((x) => x.trim())
                  .filter(Boolean);

            const parsedSocials = parseLines(socials.value)
               .map((line) => {
                  const [label, ...rest] = line.split('|');
                  return {
                     label: (label || '').trim(),
                     href: rest.join('|').trim()
                  };
               })
               .filter((x) => x.label && x.href);

            const parsedFaqs = parseLines(faqs.value)
               .map((line) => {
                  const [question, ...rest] = line.split('|');
                  return {
                     question: (question || '').trim(),
                     answer: rest.join('|').trim()
                  };
               })
               .filter((x) => x.question && x.answer);

            const { error: saveError } =
               await supabase
                  .from('contact_page')
                  .upsert({
                     id: 'main',
                     hero_title: heroTitle.value.trim(),
                     hero_description: heroDescription.value.trim(),
                     address_lines: parseLines(address.value),
                     email: email.value.trim(),
                     office_hours: officeHours.value.trim(),
                     map_image_url: mapUrl.value.trim() || null,
                     socials: parsedSocials,
                     subjects: parseLines(subjects.value),
                     faqs: parsedFaqs,
                     updated_at: new Date().toISOString()
                  });

            save.removeAttribute('disabled');

            if (saveError) {
               saveStatus.textContent = `Error: ${saveError.message}`;
               toast('Could not save Contact page.', 'err');
               return;
            }

            saveStatus.textContent = 'Saved successfully.';
            toast('Contact page saved.');
         });

         const messagesSection = el(
            'div',
            { class: 'editor-card' }
         );

         const messagesHeader = el(
            'div',
            { class: 'section-header' }
         );

         messagesHeader.innerHTML = `
            <div>
               <h3>Contact Messages</h3>
               <p>Messages submitted from the public contact form.</p>
            </div>
         `;

         const messagesList = el(
            'div',
            { class: 'card-list' }
         );

         messagesSection.append(
            messagesHeader,
            messagesList
         );

         host.append(form, messagesSection);

         async function loadMessages() {
            messagesList.replaceChildren(
               loadingState()
            );

            const { data: messages, error: messagesError } =
               await supabase
                  .from('contact_messages')
                  .select('*')
                  .order('created_at', { ascending: false });

            if (messagesError) {
               messagesList.replaceChildren(
                  errorState(messagesError.message)
               );
               return;
            }

            messagesList.replaceChildren();

            if (!messages?.length) {
               messagesList.append(
                  el(
                     'div',
                     { class: 'state-card' },
                     ['No contact messages yet.']
                  )
               );
               return;
            }

            for (const message of messages) {
               const card = el(
                  'article',
                  { class: 'member-card' }
               );

               const created = message.created_at
                  ? new Date(message.created_at).toLocaleString()
                  : '';

               card.innerHTML = `
                  <div class="member-card-header">
                     <span class="card-label">${message.subject || 'General Inquiry'}</span>
                     <span class="member-id">${created}</span>
                  </div>

                  <h3>${escapeHtml(message.name || 'Unknown')}</h3>

                  <p class="muted">
                     <a href="mailto:${escapeAttr(message.email || '')}">
                        ${escapeHtml(message.email || '')}
                     </a>
                  </p>

                  <p class="message-preview">
                     ${escapeHtml(message.message || '')}
                  </p>
               `;

               const actions = el(
                  'div',
                  { class: 'member-actions' }
               );

               const status = field(
                  '',
                  message.status || 'new'
               );

               status.placeholder = 'new / read / replied';

               const saveStatus = el(
                  'button',
                  {
                     type: 'button',
                     class: 'btn small'
                  },
                  ['Update status']
               );

               saveStatus.addEventListener('click', async () => {
                  saveStatus.setAttribute('disabled', 'true');

                  const { error: updateError } =
                     await supabase
                        .from('contact_messages')
                        .update({
                           status: status.value.trim() || 'new'
                        })
                        .eq('id', message.id);

                  saveStatus.removeAttribute('disabled');

                  if (updateError) {
                     toast(updateError.message, 'err');
                  } else {
                     toast('Message status updated.');
                  }
               });

               actions.append(
                  labeled('Status', status),
                  saveStatus
               );

               card.append(actions);
               messagesList.append(card);
            }
         }

         await loadMessages();

         supabase
            .channel('contact-dashboard-live')
            .on(
               'postgres_changes',
               {
                  event: '*',
                  schema: 'public',
                  table: 'contact_messages'
               },
               () => {
                  void loadMessages();
               }
            )
            .subscribe();
      }

      function escapeHtml(value: string) {
         return value
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
      }

      function escapeAttr(value: string) {
         return escapeHtml(value);
      }



