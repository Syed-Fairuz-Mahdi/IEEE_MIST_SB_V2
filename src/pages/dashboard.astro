         align-items: center;
         justify-content: center;

         background: var(--ieee-blue);

         border-radius: 12px;

         color: white;

         font-size: 13px;
         font-weight: 800;
      }


      .login-logo-text {
         color: var(--ieee-navy);

         font-size: 13px;
         font-weight: 700;
      }


      .login-card h1 {
         margin: 0;

         color: var(--ieee-navy);

         font-size: 26px;
         line-height: 1.2;
      }


      .login-description {
         margin: -5px 0 6px;

         color: var(--text-soft);

         font-size: 14px;

         line-height: 1.6;
      }


      .login-button {
         width: 100%;

         min-height: 46px;

         margin-top: 4px;
      }


      .login-footer {
         margin: 20px 0 0;

         color: var(--text-muted);

         font-size: 12px;

         text-align: center;
      }


      /* ==========================================================
         HEADER
         ========================================================== */

      .topbar {
         position: sticky;

         top: 0;

         z-index: 100;

         min-height: 72px;

         padding:
            0 32px;

         display: flex;
         align-items: center;
         justify-content: space-between;

         gap: 20px;

         background:
            linear-gradient(
               135deg,
               var(--ieee-navy),
               var(--ieee-blue)
            );

         color: white;

         box-shadow:
            0 3px 15px
            rgba(0, 40, 85, 0.20);
      }


      .brand {
         display: flex;
         align-items: center;

         gap: 12px;
      }


      .brand-mark {
         width: 42px;
         height: 42px;

         display: flex;
         align-items: center;
         justify-content: center;

         background:
            rgba(255,255,255,0.10);

         border:
            1px solid
            rgba(255,255,255,0.22);

         border-radius: 10px;

         font-size: 11px;
         font-weight: 800;
      }


      .brand-content {
         display: flex;
         flex-direction: column;

         gap: 2px;
      }


      .brand-content strong {
         font-size: 15px;
         letter-spacing: 0.01em;
      }


      .brand-content span {
         color:
            rgba(255,255,255,0.70);

         font-size: 11px;
      }


      .user-area {
         display: flex;
         align-items: center;

         gap: 14px;
      }


      .user-info {
         display: flex;
         flex-direction: column;

         align-items: flex-end;

         gap: 2px;
      }


      .user-label {
         color:
            rgba(255,255,255,0.58);

         font-size: 10px;

         text-transform: uppercase;

         letter-spacing: 0.06em;
      }


      .user-email {
         max-width: 280px;

         overflow: hidden;

         text-overflow: ellipsis;

         white-space: nowrap;

         color: white;

         font-size: 12px;
      }


      /* ==========================================================
         DASHBOARD INTRO
         ========================================================== */

      .dashboard-intro {
         width: min(
            1180px,
            calc(100% - 40px)
         );

         margin: 0 auto;

         padding: 38px 0 25px;
      }


      .eyebrow {
         display: inline-block;

         margin-bottom: 8px;

         color: var(--ieee-blue);

         font-size: 10px;

         font-weight: 800;

         letter-spacing: 0.12em;
      }


      .dashboard-intro h1 {
         margin: 0 0 7px;

         color: var(--ieee-navy);

         font-size: 30px;

         line-height: 1.2;

         letter-spacing: -0.025em;
      }


      .dashboard-intro p {
         margin: 0;

         color: var(--text-soft);

         font-size: 14px;

         line-height: 1.6;
      }


      /* ==========================================================
         WORDPRESS-STYLE SIDEBAR
         ========================================================== */

      .dashboard-layout {
         display: grid;
         grid-template-columns: 250px minmax(0, 1fr);
         min-height: calc(100vh - 72px);
         background: #f5f7fa;
      }

      .dashboard-sidebar {
         position: sticky;
         top: 72px;
         height: calc(100vh - 72px);
         overflow-y: auto;
         padding: 22px 12px 30px;
         background: #ffffff;
         border-right: 1px solid var(--border);
         box-shadow: 2px 0 12px rgba(15, 23, 42, 0.04);
      }

      .sidebar-top {
         padding: 5px 14px 22px;
         margin-bottom: 4px;
         border-bottom: 1px solid #eef1f5;
      }

      .sidebar-top strong {
         display: block;
         margin-top: 5px;
         color: var(--ieee-navy);
         font-size: 18px;
         letter-spacing: -0.02em;
      }

      .sidebar-kicker {
         color: var(--ieee-blue);
         font-size: 9px;
         font-weight: 800;
         letter-spacing: 0.14em;
      }

      .sidebar-group-label {
         padding: 20px 14px 7px;
         color: #98a2b3;
         font-size: 10px;
         font-weight: 800;
         letter-spacing: 0.12em;
      }

      .tab {
         width: 100%;
         min-height: 43px;
         display: flex;
         align-items: center;
         gap: 11px;
         padding: 10px 13px;
         margin: 2px 0;
         border: 0;
         border-radius: 7px;
         background: transparent;
         color: #667085;
         cursor: pointer;
         font-size: 13px;
         font-weight: 600;
         text-align: left;
         transition: background .18s ease, color .18s ease, box-shadow .18s ease;
      }

      .tab:hover {
         color: var(--ieee-navy);
         background: #f3f6f9;
      }

      .tab.active {
         color: var(--ieee-blue);
         background: #eaf4fa;
         box-shadow: inset 3px 0 0 var(--ieee-blue);
      }

      .tab-icon {
         width: 22px;
         flex: 0 0 22px;
         display: inline-flex;
         align-items: center;
         justify-content: center;
         font-size: 15px;
      }

      .dashboard-content {
         min-width: 0;
         background: #f7f9fb;
      }

      .dashboard-content .dashboard-intro {
         width: min(1180px, calc(100% - 56px));
         padding: 34px 0 22px;
      }

      /* ==========================================================
         MAIN CONTENT
         ========================================================== */

      .panel-host {
         width: min(1180px, calc(100% - 56px));
         margin: 0 auto;
         padding: 4px 0 80px;
      }

      .panel {
         display: none;

         flex-direction: column;

         gap: 18px;

         animation:
            panelIn .2s ease;
      }


      .panel.active {
         display: flex;
      }


      @keyframes panelIn {

         from {
            opacity: 0;

            transform:
               translateY(5px);
         }

         to {
            opacity: 1;

            transform:
               translateY(0);
         }
      }


      /* ==========================================================
         SECTION HEADER
         ========================================================== */

      .section-header {
         display: flex;
         justify-content: space-between;

         padding-bottom: 4px;
      }


      .section-header h2 {
         margin: 0 0 6px;

         color: var(--ieee-navy);

         font-size: 22px;

         line-height: 1.3;

         letter-spacing: -0.02em;
      }


      .section-header p {
         margin: 0;

         color: var(--text-soft);

         font-size: 13px;

         line-height: 1.6;
      }


      /* ==========================================================
         FORMS
         ========================================================== */

      .edit-form,
      .add-form,
      .member-card {
         background: var(--surface);

         border:
            1px solid var(--border);

         border-radius:
            var(--radius-lg);

         box-shadow:
            var(--shadow-sm);
      }


      .edit-form {
         padding: 28px;

         display: flex;
         flex-direction: column;

         gap: 20px;
      }


      .add-form {
         padding: 24px;

         display: flex;
         flex-direction: column;

         gap: 14px;

         background:
            linear-gradient(
               180deg,
               #ffffff,
               #fafcff
            );

         border-style: dashed;
      }


      .add-form-heading {
         display: flex;
         align-items: center;

         gap: 12px;

         margin-bottom: 4px;
      }


      .add-form-heading h3 {
         margin: 0 0 2px;

         color: var(--ieee-navy);

         font-size: 15px;
      }


      .add-form-heading p {
         margin: 0;

         color: var(--text-soft);

         font-size: 12px;
      }


      .add-icon {
         width: 38px;
         height: 38px;

         display: flex;
         align-items: center;
         justify-content: center;

         background:
            var(--ieee-light);

         color:
            var(--ieee-blue);

         border-radius: 10px;

         font-size: 20px;
         font-weight: 500;
      }


      .labeled {
         display: flex;
         flex-direction: column;

         gap: 7px;
      }


      .label-text {
         color: #344054;

         font-size: 12px;

         font-weight: 700;
      }


      /* ==========================================================
         INPUTS
         ========================================================== */

      .field {
         width: 100%;

         min-height: 44px;

         padding:
            10px 13px;

         border:
            1px solid var(--border-dark);

         border-radius:
            var(--radius-sm);

         background: #fff;

         color: var(--text);

         font-size: 13px;

         outline: none;

         transition:
            border-color .15s ease,
            box-shadow .15s ease;
      }


      .field::placeholder {
         color:
            #98a2b3;
      }


      .field:hover {
         border-color:
            #98a2b3;
      }


      .field:focus {
         border-color:
            var(--ieee-blue);

         box-shadow:
            0 0 0 3px
            rgba(0, 98, 155, 0.11);
      }


      textarea.field {
         min-height: 110px;

         resize: vertical;

         line-height: 1.65;
      }


      .field.small {
         width: 90px;

         min-height: 38px;
      }


      /* ==========================================================
         BUTTONS
         ========================================================== */

      .btn {
         min-height: 40px;

         padding:
            8px 15px;

         border:
            1px solid var(--border-dark);

         border-radius:
            var(--radius-sm);

         background: white;

         color: #344054;

         font-size: 12px;

         font-weight: 700;

         cursor: pointer;

         transition:
            background .15s ease,
            border-color .15s ease,
            transform .15s ease,
            box-shadow .15s ease;
      }


      .btn:hover {
         background: #f8fafc;

         border-color:
            #98a2b3;

         box-shadow:
            var(--shadow-sm);
      }


      .btn:active {
         transform:
            translateY(1px);
      }


      .btn.small {
         min-height: 36px;

         padding:
            7px 12px;

         font-size: 12px;
      }


      .btn.primary {
         background:
            var(--ieee-blue);

         border-color:
            var(--ieee-blue);

         color: white;

         box-shadow:
            0 3px 8px
            rgba(0, 98, 155, 0.17);
      }


      .btn.primary:hover {
         background:
            var(--ieee-blue-dark);

         border-color:
            var(--ieee-blue-dark);

         box-shadow:
            0 5px 12px
            rgba(0, 98, 155, 0.22);
      }


      .btn.ghost {
         min-height: 36px;

         background:
            rgba(255,255,255,0.08);

         border-color:
            rgba(255,255,255,0.25);

         color: white;
      }


      .btn.ghost:hover {
         background:
            rgba(255,255,255,0.16);

         border-color:
            rgba(255,255,255,0.4);
      }


      .btn.danger {
         background:
            var(--danger-bg);

         border-color:
            #fecdca;

         color:
            var(--danger);
      }


      .btn.danger:hover {
         background:
            #fee4e2;

         border-color:
            #fda29b;
      }


      .btn:disabled {
         opacity: .55;

         cursor: not-allowed;

         box-shadow: none;
      }


      /* ==========================================================
         IMAGE PICKER
         ========================================================== */

      .imgpick {
         min-height: 110px;

         display: flex;
         align-items: center;

         gap: 18px;

         padding: 12px;

         background:
            var(--surface-soft);

         border:
            1px solid var(--border);

         border-radius:
            var(--radius-md);
      }


      .imgpick-preview {
         width: 88px;
         height: 88px;

         flex: 0 0 88px;

         object-fit: cover;

         border:
            1px solid var(--border);

         border-radius:
            10px;

         background:
            #eef2f6;

         box-shadow:
            var(--shadow-sm);
      }


      .imgpick-info {
         min-width: 0;

         display: flex;
         flex-direction: column;

         gap: 5px;
      }


      .imgpick-title {
         color: var(--ieee-navy);

         font-size: 13px;
      }


      .imgpick-help {
         color:
            var(--text-muted);

         font-size: 11px;
      }


      .imgpick-input {
         max-width: 320px;

         margin-top: 4px;

         color:
            var(--text-soft);

         font-size: 11px;
      }


      .imgpick-status {
         font-size: 11px;

         color:
            var(--text-soft);
      }


      .success-text {
         color:
            var(--success);
      }


      .error-text {
         color:
            var(--danger);
      }


      /* ==========================================================
         CARDS
         ========================================================== */

      .card-list {
         display: grid;

         grid-template-columns:
            repeat(
               2,
               minmax(0, 1fr)
            );

         gap: 16px;
      }


      .member-card {
         padding: 20px;

         display: flex;
         flex-direction: column;

         gap: 12px;

         transition:
            transform .15s ease,
            box-shadow .15s ease;
      }


      .member-card:hover {
         transform:
            translateY(-1px);

         box-shadow:
            var(--shadow-md);
      }


      .member-card-header {
         display: flex;
         align-items: center;
         justify-content: space-between;

         padding-bottom: 3px;
      }


      .card-label {
         color:
            var(--ieee-blue);

         font-size: 9px;

         font-weight: 800;

         letter-spacing: .10em;
      }


      .member-id {
         color:
            var(--text-muted);

         font-size: 11px;
      }


      .event-status {
         padding:
            4px 8px;

         border-radius:
            999px;

         background:
            var(--warning-bg);

         color:
            var(--warning);

         font-size: 10px;

         font-weight: 700;
      }


      /* ==========================================================
         ACTIONS
         ========================================================== */

      .form-footer {
         display: flex;

         align-items: center;

         justify-content: space-between;

         gap: 12px;

         padding-top: 5px;
      }


      .row-actions {
         display: flex;
         align-items: center;

         flex-wrap: wrap;

         gap: 8px;

         padding-top: 4px;
      }


      .row-actions .muted {
         margin-left: auto;
      }


      /* ==========================================================
         CHECKBOXES
         ========================================================== */

      .checkbox-row {
         min-height: 42px;

         display: flex;
         align-items: center;

         gap: 10px;

         padding:
            9px 12px;

         border:
            1px solid var(--border);

         border-radius:
            var(--radius-sm);

         background:
            #fafbfc;

         color:
            #344054;

         font-size: 12px;

         cursor: pointer;
      }


      .checkbox-row input {
         width: 17px;
         height: 17px;

         accent-color:
            var(--ieee-blue);

         cursor: pointer;
      }


      /* ==========================================================
         INFO BANNER
         ========================================================== */

      .info-banner {
         display: flex;
         align-items: center;

         gap: 10px;

         padding:
            12px 15px;

         border:
            1px solid #cfe3f2;

         border-radius:
            10px;

         background:
            #f0f8fd;

         color:
            #245273;

         font-size: 12px;

         line-height: 1.5;
      }


      .info-icon {
         width: 28px;
         height: 28px;

         flex: 0 0 28px;

         display: flex;
         align-items: center;
         justify-content: center;

         border-radius:
            8px;

         background:
            rgba(0,98,155,.10);

         font-size: 13px;
      }


      /* ==========================================================
         PUBLISHING
         ========================================================== */

      .publish-card {
         display: flex;

         gap: 18px;

         padding: 24px;

         border:
            1px solid #cfe3f2;

         border-radius:
            var(--radius-lg);

         background:
            linear-gradient(
               135deg,
               #eef8fd,
               #ffffff
            );
      }


      .publish-icon {
         width: 50px;
         height: 50px;

         flex: 0 0 50px;

         display: flex;
         align-items: center;
         justify-content: center;

         border-radius:
            13px;

         background:
            rgba(0,98,155,.10);

         font-size: 23px;
      }


      .publish-card h3 {
         margin: 0 0 7px;

         color:
            var(--ieee-navy);

         font-size: 16px;
      }


      .publish-card p {
         margin: 0 0 8px;

         color:
            #45627a;

         font-size: 13px;

         line-height: 1.65;
      }


      .publish-card p:last-child {
         margin-bottom: 0;
      }


      .hook-section {
         padding: 24px;

         background:
            white;

         border:
            1px solid var(--border);

         border-radius:
            var(--radius-lg);

         box-shadow:
            var(--shadow-sm);

         display: flex;
         flex-direction: column;

         gap: 13px;
      }


      .publish-action {
         padding:
            22px 24px;

         border:
            1px solid var(--border);

         border-radius:
            var(--radius-lg);

         background:
            white;

         display: flex;
         flex-direction: column;

         gap: 10px;
      }


      .publish-button {
         align-self: flex-start;

         min-height: 45px;

         padding:
            10px 20px;
      }


      /* ==========================================================
         STATE
         ========================================================== */

      .state-card {
         min-height: 220px;

         display: flex;
         flex-direction: column;

         align-items: center;
         justify-content: center;

         gap: 12px;

         background:
            white;

         border:
            1px solid var(--border);

         border-radius:
            var(--radius-lg);

         color:
            var(--text-soft);
      }


      .state-card p {
         margin: 0;

         font-size: 13px;
      }


      .error-state {
         padding: 25px;

         color:
            var(--danger);

         text-align: center;
      }


      .error-state strong {
         font-size: 15px;
      }


      .error-state p {
         max-width: 650px;

         color:
            var(--danger);

         line-height: 1.6;
      }


      /* ==========================================================
         TOAST
         ========================================================== */

      .toast {
         position: fixed;

         left: 50%;
         bottom: 28px;

         z-index: 1000;

         max-width:
            min(
               500px,
               calc(100% - 32px)
            );

         padding:
            13px 18px;

         border-radius:
            10px;

         background:
            #101828;

         color:
            white;

         font-size: 13px;

         font-weight: 600;

         box-shadow:
            0 12px 30px
            rgba(16,24,40,.22);

         opacity: 0;

         pointer-events: none;

         transform:
            translate(-50%, 20px);

         transition:
            opacity .2s ease,
            transform .2s ease;
      }


      .toast.show {
         opacity: 1;

         transform:
            translate(-50%, 0);
      }


      .toast.err {
         background:
            var(--danger);
      }


      /* ==========================================================
         ACCESSIBILITY
         ========================================================== */

      button:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible {
         outline:
            3px solid
            rgba(0,98,155,.20);

         outline-offset: 2px;
      }


      /* ==========================================================
         TABLET
         ========================================================== */

      .form-section-title {
         margin-top: 18px;
         padding: 14px 0 4px;
         border-top: 1px solid var(--border);
         font-size: 16px;
         font-weight: 800;
         color: var(--ieee-navy);
      }

      .form-section-title:first-child {
         margin-top: 0;
         border-top: 0;
      }

      code {
         padding: 2px 5px;
         border-radius: 4px;
         background: rgba(0, 98, 155, 0.08);
         font-size: 12px;
      }


      @media (max-width: 900px) {

         .topbar {
            padding:
               0 20px;
         }


         .dashboard-intro {
            width:
               calc(100% - 30px);

            padding-top:
               30px;
         }


         .dashboard-layout {
            grid-template-columns: 220px minmax(0, 1fr);
         }

         .dashboard-content .dashboard-intro,
         .panel-host {
            width: calc(100% - 36px);
         }


         .card-list {
            grid-template-columns:
               1fr;
         }


      }


      /* ==========================================================
         MOBILE
         ========================================================== */

      @media (max-width: 600px) {

         .topbar {
            min-height:
               auto;

            padding:
               12px 15px;

            flex-direction:
               column;

            align-items:
               stretch;

            gap: 12px;
         }


         .brand {
            justify-content:
               flex-start;
         }


         .user-area {
            justify-content:
               space-between;
         }


         .user-info {
            align-items:
               flex-start;
         }


         .user-email {
            max-width:
               210px;
         }


         .dashboard-layout {
            display: block;
         }

         .dashboard-sidebar {
            position: relative;
            top: 0;
            height: auto;
            max-height: 320px;
            border-right: 0;
            border-bottom: 1px solid var(--border);
         }

         .dashboard-content .dashboard-intro,
         .panel-host {
            width: calc(100% - 24px);
         }

         .tab {
            padding: 11px 12px;
            font-size: 12px;
         }


         .dashboard-intro {
            width:
               calc(100% - 24px);

            padding:
               25px 0 18px;
         }


         .dashboard-intro h1 {
            font-size:
               25px;
         }


         .panel-host {
            width:
               calc(100% - 20px);

            padding:
               20px 0 55px;
         }


         .edit-form,
         .member-card,
         .add-form,
         .hook-section,
         .publish-action {
            padding:
               17px;

            border-radius:
               13px;
         }


         .section-header h2 {
            font-size:
               19px;
         }


         .section-header p {
            font-size:
               12px;
         }


         .imgpick {
            flex-direction:
               column;

            align-items:
               flex-start;
         }


         .imgpick-preview {
            width:
               105px;

            height:
               105px;

            flex-basis:
               105px;
         }


         .imgpick-input {
            width:
               100%;

            max-width:
               none;
         }


         .form-footer {
            flex-direction:
               column;

            align-items:
               stretch;
         }


         .form-footer .btn {
            width:
               100%;
         }


         .row-actions {
