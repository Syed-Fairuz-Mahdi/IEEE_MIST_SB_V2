      async function renderAboutPanel(host: HTMLElement) {
         host.replaceChildren(loadingState());

         const { data, error } = await supabase
            .from('about_page')
            .select('*')
            .eq('id', 'main')
            .maybeSingle();

         if (error) {
            host.replaceChildren(errorState(error.message));
            return;
         }

         const row = data || {
            id: 'main', hero_title: '', hero_description: '', stats: [], story: [],
            chair_name: '', chair_role: '', chair_image_url: null, chair_message: [],
            journey: [], mission: '', mission_source: '', vision: '', programs: [],
            contributors: [], cta_heading: '', cta_description: '', cta_button: '', cta_link: ''
         };

         host.replaceChildren();
         host.append(sectionHeader(
            'About Page',
            'Manage all editable content displayed on the public About page.'
         ));

         const form = el('form', { class: 'edit-form' });
         const heroTitle = field('Hero title', row.hero_title || '');
         const heroDescription = field('Hero description', row.hero_description || '', true, 4);
         const statsField = field('Statistics', (row.stats || []).map((x: any) => `${x.value || ''} | ${x.label || ''}`).join('\n'), true, 6);
         const story = field('Our Story paragraphs', (row.story || []).join('\n\n'), true, 12);

         let chairImageUrl: string | null = row.chair_image_url || null;
         const chairName = field("Chair's name", row.chair_name || '');
         const chairRole = field("Chair's role", row.chair_role || '');
         const chairMessage = field("Chair's message paragraphs", (row.chair_message || []).join('\n\n'), true, 12);
         const chairPicker = imagePicker(chairImageUrl, 'about/chair', (url) => chairImageUrl = url);

         const journeyField = field('Our Journey', (row.journey || []).map((x: any) => `${x.year || ''} | ${x.title || ''} | ${x.description || ''}`).join('\n'), true, 9);
         const mission = field('Mission', row.mission || '', true, 5);
         const missionSource = field('Mission source', row.mission_source || '');
         const vision = field('Vision', row.vision || '', true, 5);
         const programs = field('Programs', (row.programs || []).map((x: any) => `${x.title || ''} | ${x.description || ''} | ${x.href || ''} | ${x.icon || ''}`).join('\n'), true, 9);
         const contributors = field('Contributors', (row.contributors || []).map((x: any) => `${x.name || ''} | ${x.role || ''} | ${x.avatar || ''}`).join('\n'), true, 7);
         const ctaHeading = field('CTA heading', row.cta_heading || '');
         const ctaDescription = field('CTA description', row.cta_description || '', true, 4);
         const ctaButton = field('CTA button text', row.cta_button || '');
         const ctaLink = field('CTA button link', row.cta_link || '');

         const note = el('div', { class: 'info-banner' });
         note.innerHTML = `<span class="info-icon">ℹ️</span><span><strong>Format:</strong> one item per line. Statistics: <code>value | label</code>. Journey: <code>year | title | description</code>. Programs: <code>title | description | link | icon</code>. Contributors: <code>name | role | avatar URL</code>.</span>`;

         const status = el('span', { class: 'muted small' }, ['']);
         const save = el('button', { type: 'submit', class: 'btn primary' }, ['Save About Page']);

         const title = (text: string) => el('div', { class: 'form-section-title' }, [text]);
         form.append(
            title('Hero'), labeled('Hero title', heroTitle), labeled('Hero description', heroDescription),
            title('Statistics'), labeled('Statistics', statsField),
            title('Our Story'), labeled('Story', story),
            title("Message from the Chair"), labeled('Photo', chairPicker), labeled("Chair's name", chairName), labeled("Chair's role", chairRole), labeled('Message', chairMessage),
            title('Our Journey'), labeled('Journey', journeyField),
            title('Mission & Vision'), labeled('Mission', mission), labeled('Mission source', missionSource), labeled('Vision', vision),
            title('Programs'), labeled('Programs', programs),
            title('Contributors'), labeled('Contributors', contributors),
            title('Call to Action'), labeled('CTA heading', ctaHeading), labeled('CTA description', ctaDescription), labeled('CTA button text', ctaButton), labeled('CTA button link', ctaLink),
            note, el('div', { class: 'form-footer' }, [status, save])
         );

         form.addEventListener('submit', async (e) => {
            e.preventDefault();
            save.setAttribute('disabled', 'true');
            save.textContent = 'Saving...';
            status.textContent = 'Saving About page...';

            try {
               const lines = (v: string) => v.split('\n').map(x => x.trim()).filter(Boolean);
               const paragraphs = (v: string) => v.split(/\n\s*\n/).map(x => x.replace(/\n/g, ' ').trim()).filter(Boolean);
               const parts = (line: string, count: number) => { const a = line.split('|').map(x => x.trim()); while (a.length < count) a.push(''); return a; };

               const parsedStats = lines(statsField.value).map(line => { const [value, label] = parts(line, 2); return { value, label }; }).filter(x => x.value || x.label);
               const parsedJourney = lines(journeyField.value).map(line => { const [year, title, description] = parts(line, 3); return { year, title, description }; }).filter(x => x.year || x.title || x.description);
               const parsedPrograms = lines(programs.value).map(line => { const [title, description, href, icon] = parts(line, 4); return { title, description, href: href || undefined, icon: icon || undefined }; }).filter(x => x.title || x.description);
               const parsedContributors = lines(contributors.value).map(line => { const [name, role, avatar] = parts(line, 3); return { name, role, avatar: avatar || undefined }; }).filter(x => x.name || x.role || x.avatar);

               const { error: saveError } = await supabase.from('about_page').upsert({
                  id: 'main', hero_title: heroTitle.value.trim(), hero_description: heroDescription.value.trim(), stats: parsedStats, story: paragraphs(story.value),
                  chair_name: chairName.value.trim(), chair_role: chairRole.value.trim(), chair_image_url: chairImageUrl, chair_message: paragraphs(chairMessage.value),
                  journey: parsedJourney, mission: mission.value.trim(), mission_source: missionSource.value.trim(), vision: vision.value.trim(), programs: parsedPrograms,
                  contributors: parsedContributors, cta_heading: ctaHeading.value.trim(), cta_description: ctaDescription.value.trim(), cta_button: ctaButton.value.trim(),
                  cta_link: ctaLink.value.trim(), updated_at: new Date().toISOString()
               }, { onConflict: 'id' });

               if (saveError) throw saveError;
               status.textContent = 'Changes saved successfully.';
               toast('About page saved successfully.');
            } catch (err) {
               const message = err instanceof Error ? err.message : String(err);
               status.textContent = `Error: ${message}`;
               toast('Could not save About page.', 'err');
            } finally {
               save.removeAttribute('disabled');
               save.textContent = 'Save About Page';
            }
         });

         host.append(form);
      }


