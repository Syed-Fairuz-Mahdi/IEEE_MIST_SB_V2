      async function renderSettingsPanel(
         host: HTMLElement
      ) {

         host.replaceChildren(
            loadingState()
         );


         const {
            data,
            error
         } =
            await supabase
               .from('site_settings')
               .select('*')
               .eq(
                  'key',
                  'deploy_hook_url'
               )
               .maybeSingle();


         host.replaceChildren();


         host.append(
            sectionHeader(
               'Publishing',
               'Save your content first, then trigger a new website build.'
            )
         );


         const explainer =
            el(
               'div',
               {
                  class: 'publish-card'
               }
            );


         explainer.innerHTML = `
            <div class="publish-icon">
               🚀
            </div>

            <div>
               <h3>
                  Publish website changes
               </h3>

               <p>
                  Saved content is stored in Supabase.
                  Because the public website is statically
                  generated, the live website needs a new
                  Vercel build to display the latest changes.
               </p>

               <p>
                  Add your Vercel Deploy Hook URL below.
                  After saving your content, click
                  <strong>Publish changes</strong>.
               </p>
            </div>
         `;


         const hookInput =
            field(
               '',
               data?.value || ''
            );


         hookInput.placeholder =
            'https://api.vercel.com/v1/integrations/deploy/...';


         const saveHook =
            el(
               'button',
               {
                  class: 'btn small',
                  type: 'button'
               },
               ['Save hook URL']
            );


         const hookStatus =
            el(
               'span',
               {
                  class: 'muted small'
               },
               ['']
            );


         saveHook.addEventListener(
            'click',
            async () => {

               hookStatus.textContent =
                  'Saving...';


               const {
                  error: err
               } =
                  await supabase
                     .from('site_settings')
                     .upsert({
                        key:
                           'deploy_hook_url',

                        value:
                           hookInput.value.trim(),

                        updated_at:
                           new Date().toISOString()
                     });


               hookStatus.textContent =
                  err
                     ? `Error: ${err.message}`
                     : 'Hook URL saved.';


               if (!err) {

                  toast(
                     'Deploy Hook URL saved.'
                  );
               }
            }
         );


         const publishBtn =
            el(
               'button',
               {
                  class:
                     'btn primary publish-button',
                  type: 'button'
               },
               ['🚀 Publish changes now']
            );


         const publishStatus =
            el(
               'p',
               {
                  class: 'muted small'
               },
               ['']
            );


         publishBtn.addEventListener(
            'click',
            async () => {

               const url =
                  hookInput.value.trim();


               if (!url) {

                  publishStatus.textContent =
                     'Add and save a Deploy Hook URL first.';

                  return;
               }


               publishBtn.setAttribute(
                  'disabled',
                  'true'
               );


               publishBtn.textContent =
                  'Publishing...';


               publishStatus.textContent =
                  'Triggering a new Vercel build...';


               try {

                  await fetch(
                     url,
                     {
                        method: 'POST',
                        mode: 'no-cors'
                     }
                  );


                  publishStatus.textContent =
                     'Build triggered. Changes should go live shortly.';


                  toast(
                     'Publish triggered successfully.'
                  );

               } catch (err: any) {

                  publishStatus.textContent =
                     `Could not reach the deploy hook: ${
                        err.message || err
                     }`;

                  toast(
                     'Could not trigger publishing.',
                     'err'
                  );
               }


               publishBtn.removeAttribute(
                  'disabled'
               );


               publishBtn.textContent =
                  '🚀 Publish changes now';
            }
         );


         const hookSection =
            el(
               'div',
               {
                  class: 'hook-section'
               }
            );


         hookSection.append(

            labeled(
               'Vercel Deploy Hook URL',
               hookInput
            ),

            el(
               'div',
               {
                  class: 'row-actions'
               },
               [
                  saveHook,
                  hookStatus
               ]
            )
         );


         host.append(
            explainer,
            hookSection,
            el(
               'div',
               {
                  class: 'publish-action'
               },
               [
                  publishBtn,
                  publishStatus
               ]
            )
         );
      }


