     // ============================================================
// AUTH BOOT
// ============================================================

let renderedUserId: string | null = null;
let authGeneration = 0;

async function syncAuthUI(session: any) {
   const generation = ++authGeneration;
   const user = session?.user;

   // User signed out
   if (!user) {
      renderedUserId = null;
      renderLogin();
      return;
   }

   // IMPORTANT:
   // Ignore INITIAL_SESSION, TOKEN_REFRESHED and other auth events
   // when the same user is already rendered.
   if (renderedUserId === user.id) {
      return;
   }

   renderedUserId = user.id;

   try {
      await renderShell(
         user.email || 'Signed in'
      );
   } catch (error) {
      // Allow another attempt if rendering fails.
      if (generation === authGeneration) {
         renderedUserId = null;
         console.error(
            'Dashboard render failed:',
            error
         );
      }
   }
}


// Initial dashboard load
const {
   data: {
      session
   }
} = await supabase.auth.getSession();

await syncAuthUI(session);


// Listen for real authentication changes.
// Do NOT rebuild the dashboard for token refreshes.
supabase.auth.onAuthStateChange(
   (_event, session) => {
      queueMicrotask(() => {
         void syncAuthUI(session);
      });
   }
);
