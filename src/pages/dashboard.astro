         function addEventForm() {

            const form =
               el(
                  'form',
                  {
                     class: 'add-form'
                  }
               );


            const heading =
               el(
                  'div',
                  {
                     class: 'add-form-heading'
                  }
               );


            heading.innerHTML = `
               <span class="add-icon">+</span>

               <div>
                  <h3>
                     Add new activity
                  </h3>

                  <p>
                     Create a new activity or event.
                  </p>
               </div>
            `;


            const title =
               field('', '');


            const slug =
               field('', '');


            const date =
               el(
                  'input',
                  {
                     type: 'date',
                     class: 'field'
                  }
               ) as HTMLInputElement;


            const chapter =
               chapterSelect('SB');


            const description =
               field(
                  '',
                  '',
                  true,
                  3
               );


            title.placeholder =
               'Event title';


            slug.placeholder =
               'url-slug-like-this';


            description.placeholder =
               'One or two sentences about the event';


            let imageUrl:
               string | null = null;


            const picker =
               imagePicker(
                  null,
                  'events',
                  (url) =>
                     imageUrl = url
               );


            const submit =
               el(
                  'button',
                  {
                     type: 'submit',
                     class: 'btn primary'
                  },
                  ['+ Add activity / event']
               );


            form.append(

               heading,

               picker,

               labeled(
                  'Title',
                  title
               ),

               labeled(
                  'Slug',
                  slug
               ),

               labeled(
                  'Date',
                  date
               ),

               labeled(
                  'Chapter',
                  chapter
               ),

               labeled(
                  'Short description',
                  description
               ),

               submit
            );


            form.addEventListener(
               'submit',
               async (e) => {

                  e.preventDefault();


                  if (
                     !title.value.trim()
                     ||
                     !slug.value.trim()
                     ||
                     !date.value
                     ||
                     !description.value.trim()
                  ) {

                     toast(
                        'Title, slug, date and description are required.',
                        'err'
                     );

                     return;
                  }


                  submit.setAttribute(
                     'disabled',
                     'true'
                  );


                  const {
                     data: inserted,
                     error: err
                  } =
                     await supabase
                        .from('events')
                        .insert({

                           title:
                              title.value.trim(),

                           slug:
                              slug.value
                                 .trim()
                                 .toLowerCase(),

                           event_date:
                              date.value,

                           chapter:
                              chapter.value,

                           description:
                              description.value.trim(),

                           image_url:
                              imageUrl,

                           published:
                              false
                        })
                        .select()
                        .single();


                  submit.removeAttribute(
                     'disabled'
                  );


                  if (err) {

                     toast(
                        err.message,
                        'err'
                     );

                     return;
                  }


                  list.append(
                     eventCard(inserted)
                  );


                  form.reset();

                  imageUrl = null;


                  toast(
                     'Activity added as a draft.'
                  );
               }
            );


            return form;
         }
      }


